# Authentication
APP_EMAIL=you@example.com
APP_PASSWORD=change-me
APP_SECRET=use-a-long-random-secret

# Persistent CRM data (GitHub fine-grained token with Contents: Read and write)
GITHUB_TOKEN=github_pat_xxx

# OpenAI
OPENAI_API_KEY=sk-xxx
# Fast model for scripts, note summaries, imports and enrichment.
OPENAI_MODEL=gpt-4o-mini
# Higher-capability model used only by Alpinia Agent for CRM actions.
CRM_AGENT_MODEL=gpt-5.6-sol

# Vercel Blob (create a Private Blob store in Vercel Storage)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
